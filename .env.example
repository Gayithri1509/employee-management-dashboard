# Supabase connection settings (Stage 2 -- data-access foundation only).
#
# Copy this file to .env and fill in your own project's values from the
# Supabase Dashboard: Project Settings > API. Never commit the real .env
# file -- it is already covered by .gitignore.

# Project URL (Settings > API > Project URL)
VITE_SUPABASE_URL=

# Publishable ("anon") key (Settings > API > Project API keys > anon public)
#
# This is the ONLY Supabase key that belongs in frontend code. Do not put
# the service_role key in this file, in any VITE_-prefixed variable, or
# anywhere else the browser can read it -- see docs/supabase-client-setup.md
# for why.
VITE_SUPABASE_PUBLISHABLE_KEY=
